# Copy to .env and edit. docker compose reads this file automatically.
DB_NAME=shofiniakol
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_PORT=5432
SERVER_PORT=8080

# Generate with:  openssl rand -base64 48      (must be >= 32 characters)
JWT_SECRET=change-me-change-me-change-me-change-me

# Public URL that clients use to reach this API (used to build image URLs)
APP_PUBLIC_BASE_URL=http://localhost:8080

# Production: keep only the real migrations (no demo data)
FLYWAY_LOCATIONS=classpath:db/migration

# DEV ONLY. Leave empty in production so real SMS OTPs are required.
OTP_DEV_FIXED_CODE=

# This phone becomes ADMIN the first time it logs in
BOOTSTRAP_ADMIN_PHONE=+963900000001

CORS_ALLOWED_ORIGINS=*
SWAGGER_ENABLED=false

# Shown to the app in GET /api/v1/config
SUPPORT_WHATSAPP=963900000000
SUPPORT_PHONE=+963900000000
SHAM_CASH_ACCOUNT=
